{
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@opengeni/web-host-extension": ["./src/host-extension/none/index.ts"],
      "@opengeni/web-host-extension/style.css": ["./src/host-extension/none/style.css"]
    },
    "types": ["vite/client", "node", "bun"]
  },
  "include": ["src", "office/src", "vite.config.ts", "vite.office.config.ts"]
}
